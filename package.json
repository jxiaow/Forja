{
  "name": "forja",
  "displayName": "Forja (Dev)",
  "publisher": "forja",
  "description": "Build, run, debug C++ projects — Qt (qmake) and C++ (.sln/Makefile) in one extension",
  "version": "0.7.55.dev",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.pro",
    "workspaceContains:**/*.sln",
    "workspaceContains:**/Makefile"
  ],
  "main": "./out/extension.js",
  "bin": {
    "forja": "./out/cli/index.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "forja.status",
        "title": "Forja: Status"
      },
      {
        "command": "forja.init",
        "title": "Forja: Init Workspace"
      },
      {
        "command": "forja.list",
        "title": "Forja: List"
      },
      {
        "command": "forja.use",
        "title": "Forja: Use Target"
      },
      {
        "command": "forja.remote",
        "title": "Forja: Remote"
      },
      {
        "command": "forja.config.openPage",
        "title": "Forja: Open Config Page"
      },
      {
        "command": "forja.server",
        "title": "Forja: Server"
      },
      {
        "command": "forja.build",
        "title": "Forja: Build"
      },
      {
        "command": "forja.run",
        "title": "Forja: Run"
      },
      {
        "command": "forja.debug",
        "title": "Forja: Debug"
      },
      {
        "command": "forja.stop",
        "title": "Forja: Stop"
      },
      {
        "command": "forja.clean",
        "title": "Forja: Clean"
      },
      {
        "command": "forja.doctor",
        "title": "Forja: Doctor"
      },
      {
        "command": "forja.sync",
        "title": "Forja: Sync Changes"
      },
      {
        "command": "forja.openDesigner",
        "title": "Forja: Open with Qt Designer"
      },
      {
        "command": "forja.showSyncTab",
        "title": "Forja: 打开远程页"
      },
      {
        "command": "forja.syncTestConnection",
        "title": "Forja: 测试远程连接"
      },
      {
        "command": "forja.remoteWorkbench",
        "title": "Forja Remote: Workbench"
      },
      {
        "command": "forja.remoteTest",
        "title": "Forja Remote: Test"
      },
      {
        "command": "forja.remoteBootstrap",
        "title": "Forja Remote: Bootstrap"
      },
      {
        "command": "forja.remoteTransferStatus",
        "title": "Forja Remote: Transfer Status"
      },
      {
        "command": "forja.ps",
        "title": "Forja Remote: PS"
      },
      {
        "command": "forja._showActions",
        "title": "Forja: Actions"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "forja.showSyncTab",
          "when": "false"
        },
        {
          "command": "forja.syncTestConnection",
          "when": "false"
        },
        {
          "command": "forja._showActions",
          "when": "false"
        },
        {
          "command": "forja.remoteWorkbench",
          "when": "false"
        },
        {
          "command": "forja.remoteTest",
          "when": "false"
        },
        {
          "command": "forja.remoteBootstrap",
          "when": "false"
        },
        {
          "command": "forja.remoteTransferStatus",
          "when": "false"
        },
        {
          "command": "forja.ps",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "forja.openDesigner",
          "when": "resourceExtname == .ui",
          "group": "navigation@100"
        },
        {
          "command": "forja.sync",
          "when": "resourceScheme == file",
          "group": "navigation@101"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forja",
          "title": "Forja",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forja": [
        {
          "id": "forja.configView",
          "name": "配置",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "copy-html": "node scripts/copy-html.js",
    "clean-out": "node scripts/clean-out.js",
    "sync-version": "node scripts/sync-version.js",
    "compile": "npm run sync-version && npm run clean-out && tsc -p ./ && npm run copy-html",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test --test-reporter=spec out/test",
    "lint": "eslint src/",
    "build:cli": "npm run compile && node scripts/build-cli.js",
    "build:cli:dev": "npm run compile && node scripts/build-cli.js --channel dev",
    "package": "npm run compile && node scripts/package-vs.js",
    "package:dev": "npm run compile && node scripts/package-vs.js --channel dev",
    "package:cli": "npm run build:cli",
    "package:cli:dev": "npm run build:cli:dev",
    "package:all": "npm run package && npm run package:cli",
    "package:all:dev": "npm run package:dev && npm run package:cli:dev",
    "release": "node scripts/release.js",
    "vsix": "vsce package --allow-missing-repository",
    "harness:check": "node harness/core/automation/check-harness.js",
    "harness:ops:init": "node harness/core/operations/create-operation-docs.js",
    "remote:smoke": "node scripts/remote-smoke.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "20.19.37",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "2.32.0",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  }
}
